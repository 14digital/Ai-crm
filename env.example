# Assisted Pulse — WhatsApp Applicant Intake

# ---------------------------------------------------------------------------
# Database — Supabase Postgres
# Supabase → Project Settings → Database → Connection string
#   DATABASE_URL  pooled (pgbouncer, port 6543) — used at runtime
#   DIRECT_URL    direct (port 5432)            — used by prisma migrate
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Generate a secret using `openssl rand -base64 32`
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# WhatsApp via Twilio
# Twilio Console → Account Info, and Messaging → Senders → WhatsApp senders
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# The WhatsApp sender number, E.164. Do not include the "whatsapp:" prefix.
TWILIO_WHATSAPP_NUMBER="+14155238886"
# The public URL Twilio posts to. Must match EXACTLY what is configured in the
# Twilio console, or request signature validation will fail.
# Set this in Messaging → Senders → WhatsApp senders → "When a message comes in",
# and as the status callback URL.
TWILIO_WEBHOOK_URL="https://yourdomain.com/api/webhook/whatsapp"

# ---------------------------------------------------------------------------
# AI — used only to write chat replies.
# Documents, photos and voice notes do NOT go through Gemini:
#   images → Tesseract OCR (tesseract.js)
#   PDFs   → pdf-parse (embedded text layer only; scanned PDFs read as empty)
#   audio  → Deepgram
# ---------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# Deepgram API key, used to transcribe voice notes.
# If unset, voice notes are not transcribed and the bot asks the applicant to
# type their answer instead.
DEEPGRAM_API_KEY="your-deepgram-api-key"

# ---------------------------------------------------------------------------
# Pusher (real-time inbox updates)
# ---------------------------------------------------------------------------
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="your-pusher-cluster"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="your-pusher-cluster"

# ---------------------------------------------------------------------------
# Care360 / Assisted Lives applicant API (all endpoints are non-auth)
# ---------------------------------------------------------------------------
CARE360_API_URL="https://staging.care360.14digitalhosting.co.uk"

# ---------------------------------------------------------------------------
# Encryption
# Generate a 32-character string: openssl rand -base64 24 | head -c 32
# ---------------------------------------------------------------------------
ENCRYPTION_KEY="your-32-char-encryption-key"

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# Generate keys using `npx web-push generate-vapid-keys`
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_EMAIL="mailto:admin@yourdomain.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"

# ---------------------------------------------------------------------------
# External API key (for programmatic user creation from outside the app)
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
API_SECRET_KEY="your-external-api-secret-key"
